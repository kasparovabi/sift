<Window x:Class="Sift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sift" Height="780" Width="1300" MinHeight="560" MinWidth="960"
        Background="{DynamicResource Base}"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="400" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <!-- Sources -->
    <DockPanel Grid.Column="0">
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              Padding="14,12">
        <StackPanel>
          <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" Margin="2,0,0,6" />
          <ComboBox x:Name="ThemePicker" SelectionChanged="ThemeChanged" DisplayMemberPath="Name" />
          <Button x:Name="RescanButton" Content="Rescan" Style="{StaticResource Ghost}"
                  Click="Rescan" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
          <TextBlock x:Name="StatusLine" Style="{StaticResource Dim}" Margin="2,10,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="Sift" FontSize="19" FontWeight="Bold" Margin="16,16,0,2" />
          <TextBlock Text="every session you have run" Style="{StaticResource Dim}" Margin="16,0,0,0" />

          <TextBlock Text="LISTS" Style="{StaticResource SectionHeader}" />
          <ListBox x:Name="ListsBox" Style="{StaticResource FlatList}" SelectionChanged="ListChanged">
            <ListBoxItem Content="All sessions" Tag="all" IsSelected="True" />
            <ListBoxItem Content="Today" Tag="today" />
          </ListBox>

          <TextBlock x:Name="ProjectsHeader" Text="PROJECTS" Style="{StaticResource SectionHeader}" />
          <ListBox x:Name="ProjectsBox" Style="{StaticResource FlatList}" SelectionChanged="ProjectChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Path}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Dim}"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Sessions -->
    <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,14,14,12">
          <TextBox x:Name="SearchBox" TextChanged="SearchChanged"
                   Tag="Search every session…" />
        </Border>
        <Grid>
          <ListBox x:Name="ResultsBox" Style="{StaticResource ResultList}" SelectionChanged="SessionChanged"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Line}" Style="{StaticResource Dim}" Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Dim}" Margin="0,7,0,0"
                             FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoResults" Text="Nothing matches." Style="{StaticResource Dim}"
                     HorizontalAlignment="Center" Margin="0,48,0,0" Visibility="Collapsed" />
        </Grid>
      </DockPanel>
    </Border>

    <!-- Detail -->
    <TabControl Grid.Column="2">
      <TabItem Header="Session">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,4,22,22">
          <StackPanel x:Name="DetailPanel">
            <TextBlock x:Name="DetailEmpty" Text="Pick a session to read it."
                       Style="{StaticResource Dim}" Margin="0,44,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Quick task">
        <DockPanel Margin="26,4,22,22">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Run a one-off claude -p in a folder, without opening a terminal."
                       Style="{StaticResource Dim}" Margin="0,0,0,10" TextWrapping="Wrap" />
            <TextBox x:Name="TaskFolder" Tag="Folder" Margin="0,0,0,8" />
            <TextBox x:Name="TaskPrompt" AcceptsReturn="True" Height="96" Tag="What should it do?"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
              <Button x:Name="RunTask" Content="Run" Click="RunQuickTask" />
              <Button x:Name="StopTask" Content="Stop" Style="{StaticResource Ghost}"
                      Click="StopQuickTask" Margin="8,0,0,0" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
          <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14">
            <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="TaskOutput" TextWrapping="Wrap"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="18" />
            </ScrollViewer>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
