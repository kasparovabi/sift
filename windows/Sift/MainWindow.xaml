<Window x:Class="Sift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sift" Height="760" Width="1240" MinHeight="520" MinWidth="900"
        Background="{DynamicResource Base}"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="370" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sources -->
    <DockPanel Grid.Column="0" Background="{DynamicResource Base}">
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource Dim}" Margin="2,0,0,4" />
          <ComboBox x:Name="ThemePicker" SelectionChanged="ThemeChanged" DisplayMemberPath="Name" />
          <Button x:Name="RescanButton" Content="Rescan" Style="{StaticResource Ghost}"
                  Click="Rescan" Margin="0,8,0,0" />
          <TextBlock x:Name="StatusLine" Style="{StaticResource Dim}" Margin="2,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="LISTS" Style="{StaticResource SectionHeader}" />
          <ListBox x:Name="ListsBox" Style="{StaticResource FlatList}" SelectionChanged="ListChanged">
            <ListBoxItem Content="All sessions" Tag="all" IsSelected="True" />
            <ListBoxItem Content="Today" Tag="today" />
          </ListBox>

          <TextBlock x:Name="ProjectsHeader" Text="PROJECTS" Style="{StaticResource SectionHeader}" />
          <ListBox x:Name="ProjectsBox" Style="{StaticResource FlatList}" SelectionChanged="ProjectChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Dim}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Sessions -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,1" Padding="10">
        <TextBox x:Name="SearchBox" TextChanged="SearchChanged" />
      </Border>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <ListBox x:Name="ResultsBox" Style="{StaticResource FlatList}" SelectionChanged="SessionChanged"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Line}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                             Margin="0,2,0,0" />
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoResults" Text="Nothing matches." Style="{StaticResource Dim}"
                     HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
        </Grid>
      </Border>
    </DockPanel>

    <!-- Detail -->
    <TabControl Grid.Column="2" Background="{DynamicResource Base}" BorderThickness="0" Padding="0">
      <TabItem Header="Session">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
          <StackPanel x:Name="DetailPanel">
            <TextBlock x:Name="DetailEmpty" Text="Pick a session to read it."
                       Style="{StaticResource Dim}" Margin="0,40,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Quick task">
        <DockPanel Margin="22,18">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Run a one-off claude -p in a folder, without opening a terminal."
                       Style="{StaticResource Dim}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <TextBox x:Name="TaskFolder" Margin="0,0,0,8" />
            <TextBox x:Name="TaskPrompt" AcceptsReturn="True" Height="90"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
              <Button x:Name="RunTask" Content="Run" Click="RunQuickTask" />
              <Button x:Name="StopTask" Content="Stop" Style="{StaticResource Ghost}"
                      Click="StopQuickTask" Margin="8,0,0,0" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
          <Border Background="{DynamicResource Surface}" CornerRadius="7" Padding="10">
            <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="TaskOutput" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                         FontSize="12" />
            </ScrollViewer>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
