<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SiftWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SiftWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ResultTemplate" x:DataType="local:ResultItem">
            <StackPanel Padding="4,10" Spacing="4">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind Line}" TextTrimming="CharacterEllipsis" MaxLines="2"
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Meta}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AtomTemplate" x:DataType="local:AtomItem">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="13,11" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind Statement}" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="4" Padding="6,1"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind Kind}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TurnTemplate" x:DataType="local:TurnItem">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Who}" Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold" Foreground="{x:Bind Colour}" />
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LoopTemplate" x:DataType="local:LoopItem">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="10" Padding="9,2">
                                <TextBlock Text="{x:Bind Status}" FontSize="11"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind Where}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Top">
                        <Button Content="Run" Click="RunLoop" Tag="{x:Bind Id}" />
                        <Button Content="Stop" Click="StopLoop" Tag="{x:Bind Id}" />
                        <Button Content="Delete" Click="DeleteLoop" Tag="{x:Bind Id}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="270"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    SelectionChanged="SourceSelected">

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find"
                            PlaceholderText="Search every session"
                            TextChanged="SearchTextChanged" />
        </NavigationView.AutoSuggestBox>

        <NavigationView.PaneFooter>
            <StackPanel Padding="14,6,14,14" Spacing="8">
                <ComboBox x:Name="AppearancePicker" Header="Appearance"
                          HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                          SelectionChanged="AppearanceChanged" />
                <Button x:Name="RescanButton" Content="Rescan" Click="Rescan"
                        HorizontalAlignment="Stretch" />
                <InfoBar x:Name="RetentionBar" IsOpen="False" IsClosable="False" Severity="Warning"
                         Title="Claude Code deletes old sessions">
                    <InfoBar.ActionButton>
                        <Button Content="Keep them forever" Click="DisableCleanup" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock x:Name="ArchiveLine" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid>
            <!-- Sessions -->
            <Grid x:Name="SessionsView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,0,1,0">
                    <ListView x:Name="ResultsBox" ItemTemplate="{StaticResource ResultTemplate}"
                              SelectionChanged="SessionSelected" Padding="6,0,6,12"
                              ScrollViewer.HorizontalScrollMode="Disabled" />
                    <StackPanel x:Name="EmptyResults" Visibility="Collapsed" Spacing="6"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="26"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Nothing matches." HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressRing x:Name="Busy" IsActive="True" Width="28" Height="28" />
                </Grid>

                <ScrollViewer Grid.Column="1" Padding="28,18,24,24">
                    <StackPanel x:Name="Detail" Spacing="0">
                        <TextBlock Text="Pick a session to read it."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,40,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Quick task -->
            <Grid x:Name="QuickView" Visibility="Collapsed" Padding="28,18,24,24" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock Text="Quick task" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Run a one-off claude -p in a folder, without opening a terminal."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="TaskFolder" Header="Folder" />
                    <TextBox x:Name="TaskPrompt" Header="What should it do?" Height="110"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunTask" Content="Run" Click="RunQuickTask"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="StopTask" Content="Stop" Click="StopQuickTask" IsEnabled="False" />
                        <ProgressRing x:Name="TaskBusy" IsActive="False" Width="20" Height="20"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="8" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="TaskScroll">
                        <TextBlock x:Name="TaskOutput" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Loops -->
            <Grid x:Name="LoopsView" Visibility="Collapsed" Padding="28,18,24,24" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock Text="Loops" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="A maker does the work, a separate checker grades it against your definition of done, and it repeats until it passes or runs out of attempts." />
                    <Expander Header="New loop" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10" Padding="0,8" Width="460" HorizontalAlignment="Left">
                            <TextBox x:Name="LoopTitle" Header="Title" />
                            <TextBox x:Name="LoopFolder" Header="Folder" />
                            <TextBox x:Name="LoopPrompt" Header="What should the maker do?" Height="80"
                                     AcceptsReturn="True" TextWrapping="Wrap" />
                            <ComboBox x:Name="LoopCheckKind" Header="Checked by" SelectedIndex="0"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="An agent" />
                                <ComboBoxItem Content="A command (exit 0 means done)" />
                            </ComboBox>
                            <TextBox x:Name="LoopDoneWhen" Header="Definition of done" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" />
                            <NumberBox x:Name="LoopPasses" Header="Attempts" Value="3" Minimum="1"
                                       Maximum="10" SpinButtonPlacementMode="Compact" />
                            <Button Content="Add loop" Click="AddLoop"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer>
                        <ItemsControl x:Name="LoopList" ItemTemplate="{StaticResource LoopTemplate}" />
                    </ScrollViewer>
                    <Border Grid.Column="1" CornerRadius="8" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="LoopLogScroll">
                            <TextBlock x:Name="LoopLog" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Knowledge -->
            <Grid x:Name="BrainView" Visibility="Collapsed" Padding="28,18,24,24" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Knowledge" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="BrainSubtitle" Opacity="0.7" TextWrapping="Wrap"
                               Text="Durable facts pulled out of finished sessions, and the things they are about." />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="10">
                    <InfoBar x:Name="BrainConsent" IsOpen="False" IsClosable="False"
                             Severity="Informational" Title="Extraction is off" />
                    <StackPanel x:Name="BacklogRow" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="CatchUpButton" Content="Read everything now" Click="CatchUp" />
                        <ProgressRing x:Name="BacklogBusy" IsActive="False" Width="18" Height="18" />
                        <TextBlock x:Name="BacklogLine" VerticalAlignment="Center" Opacity="0.75"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox x:Name="BrainSearch" QueryIcon="Find"
                                        PlaceholderText="Search what Sift has learned"
                                        TextChanged="BrainSearchChanged" />
                        <ListView Grid.Row="1" x:Name="AtomList" SelectionMode="None"
                                  ItemTemplate="{StaticResource AtomTemplate}" />
                    </Grid>

                    <Border Grid.Column="1" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Canvas x:Name="GraphCanvas" SizeChanged="GraphResized" />
                            <TextBlock x:Name="GraphEmpty" Opacity="0.6" TextWrapping="Wrap"
                                       MaxWidth="320" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="Nothing extracted yet. Once extraction is on, finished sessions turn into facts here and the things they mention become a graph." />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
