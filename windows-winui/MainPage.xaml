<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SiftWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SiftWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ResultTemplate" x:DataType="local:ResultItem">
            <StackPanel Padding="4,10" Spacing="4">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind Line}" TextTrimming="CharacterEllipsis" MaxLines="2"
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Meta}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TurnTemplate" x:DataType="local:TurnItem">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Who}" Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold" Foreground="{x:Bind Colour}" />
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="260"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    SelectionChanged="SourceSelected">

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find"
                            PlaceholderText="Search every session"
                            TextChanged="SearchTextChanged" />
        </NavigationView.AutoSuggestBox>

        <NavigationView.PaneFooter>
            <StackPanel Padding="14,8,14,14" Spacing="8">
                <ComboBox x:Name="AppearancePicker" Header="Appearance"
                          HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                          SelectionChanged="AppearanceChanged" />
                <Button x:Name="RescanButton" Content="Rescan" Click="Rescan"
                        HorizontalAlignment="Stretch" />
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,1,0">
                <ListView x:Name="ResultsBox" ItemTemplate="{StaticResource ResultTemplate}"
                          SelectionChanged="SessionSelected" Padding="6,0,6,12"
                          ScrollViewer.HorizontalScrollMode="Disabled" />
                <StackPanel x:Name="EmptyResults" Visibility="Collapsed" Spacing="6"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="26"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Nothing matches." HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressRing x:Name="Busy" IsActive="True" Width="28" Height="28" />
            </Grid>

            <ScrollViewer Grid.Column="1" Padding="28,18,24,24">
                <StackPanel x:Name="Detail" Spacing="0">
                    <TextBlock Text="Pick a session to read it."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,40,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
