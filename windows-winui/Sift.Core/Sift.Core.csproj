<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SiftWinUI.Core</RootNamespace>
    <AssemblyName>Sift.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Path grouping is an implementation detail with fiddly escaping, so the tests reach
         it directly rather than only through a search that would hide where it broke. -->
    <InternalsVisibleTo Include="Sift.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.16" />
  </ItemGroup>
</Project>
